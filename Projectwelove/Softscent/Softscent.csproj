    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Softscent-f99bfe75-d9a1-42e2-91c2-1e1380152c15</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
