@model Softscent.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Order Details <span class="text-muted fs-4">#@Model.Id</span></h1>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back to Orders</a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Items</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">
                                            @if(detail.Product != null)
                                            {
                                                @detail.Product.Name
                                            }
                                            else
                                            {
                                                <span>Product Unavailable</span>
                                            }
                                        </div>
                                            <small class="text-muted"><i class="fas fa-flask me-1"></i>@detail.CustomConfiguration</small>
                                        }
                                        <div class="mt-2">
                                            <a asp-controller="Reviews" asp-action="Create" asp-route-productId="@detail.ProductId" class="btn btn-sm btn-outline-warning rounded-pill">
                                                <i class="fas fa-star me-1"></i>Review
                                            </a>
                                        </div>
                                    </td>
                                    <td>$@detail.UnitPrice.ToString("N2")</td>
                                    <td>@detail.Quantity</td>
                                    <td class="text-end fw-bold">$@((detail.UnitPrice * detail.Quantity).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Grand Total</td>
                                <td class="text-end fw-bold text-primary fs-5">$@Model.TotalAmount.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Date</dt>
                        <dd class="col-sm-7">@Model.OrderDate.ToString("MMM dd, yyyy HH:mm")</dd>

                        <dt class="col-sm-5 text-muted">Status</dt>
                        <dd class="col-sm-7">
                            <span class="badge @(Model.Status == "Completed" ? "bg-success" : (Model.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark"))">
                                @Model.Status
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Shipping Info</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><i class="fas fa-map-marker-alt me-2 text-muted"></i>@Model.ShippingAddress</p>
                    <p class="mb-0"><i class="fas fa-credit-card me-2 text-muted"></i>@Model.PaymentMethod</p>
                </div>
            </div>
        </div>
    </div>
</div>
