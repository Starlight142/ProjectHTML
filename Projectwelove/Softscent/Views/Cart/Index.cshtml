@model Softscent.Models.Order

@{
    ViewData["Title"] = "Your Cart";
}

<div class="container py-5">
    <h1 class="mb-4">Shopping Cart</h1>

    @if (Model != null && Model.OrderDetails.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td>
                                <strong>@item.Product.Name</strong>
                                @if (!string.IsNullOrEmpty(item.CustomConfiguration))
                                {
                                    <br />
                                    <small class="text-muted">Blend: @item.CustomConfiguration</small>
                                }
                            </td>
                            <td>@item.UnitPrice.ToString("C")</td>
                            <td>@item.Quantity</td>
                            <td>@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                     <tr>
                        <td colspan="3" class="text-end"><strong>Grand Total:</strong></td>
                        <td><strong>@Model.OrderDetails.Sum(x => x.UnitPrice * x.Quantity).ToString("C")</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="text-end mt-4">
            <a asp-action="Checkout" class="btn btn-primary btn-lg">Proceed to Checkout</a>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-basket fa-3x text-muted mb-3"></i>
            <h3>Your cart is empty</h3>
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary mt-3">Start Shopping</a>
        </div>
    }
</div>
