@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container py-5 text-center">
    <div class="card p-5 mx-auto" style="max-width: 600px;">
        <div class="mb-4">
            <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
        </div>
        <h1 class="display-5 fw-bold text-success">Order Confirmed!</h1>
        <p class="lead mb-4">Thank you for your purchase. Your order has been received and is being processed.</p>
        
        <p class="text-muted">You will receive an email confirmation shortly.</p>
        
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
        </div>
    </div>
</div>
