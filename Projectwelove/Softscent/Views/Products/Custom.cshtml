@model IEnumerable<Softscent.Models.Herb>

@{
    ViewData["Title"] = "Create Custom Blend";
}

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-lg-6">
            <h1 class="mb-4 display-4">Craft Your Scent</h1>
            <p class="lead mb-5">Select your favorite herbs to create a unique inhaler blend tailored to your needs.</p>
        </div>
        <div class="col-lg-6">
            <div class="card p-5 glass-nav">
                <form asp-action="AddToCartCustom" method="post">
                    <h3 class="mb-4">Select Ingredients</h3>
                    <div class="mb-4" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var herb in Model)
                        {
                            <div class="form-check mb-3">
                                <input class="form-check-input herb-checkbox" type="checkbox" value="@herb.Name" id="herb_@herb.Id" name="selectedHerbs_array">
                                <label class="form-check-label d-flex justify-content-between w-100 pe-3" for="herb_@herb.Id">
                                    <span>@herb.Name</span>
                                    <span class="text-muted small">@herb.Benefit</span>
                                </label>
                            </div>
                        }
                         @if (!Model.Any())
                        {
                             <p>No herbs available to select.</p>
                        }
                    </div>
                    
                    <!-- Hidden input to store comma separated string -->
                    <input type="hidden" name="selectedHerbs" id="selectedHerbsInput" />

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg" onclick="prepareSubmission()">
                            Create Blend ($59.00)
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function prepareSubmission() {
            var checked = document.querySelectorAll('.herb-checkbox:checked');
            var values = Array.from(checked).map(c => c.value);
            document.getElementById('selectedHerbsInput').value = values.join(', ');
        }
    </script>
}
