@page
@model ErrorModel
@{
    ViewData["Title"] = "เกิดข้อผิดพลาด";
}

<h1 class="text-danger">เกิดข้อผิดพลาด</h1>
<h2 class="text-danger">เกิดข้อผิดพลาดขณะประมวลผลคำขอของคุณ</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>รหัสคำขอ:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>โหมดการพัฒนา</h3>
<p>
    การเปลี่ยนเป็นสภาพแวดล้อม <strong>Development</strong> (การพัฒนา) จะแสดงข้อมูลรายละเอียดเกี่ยวกับข้อผิดพลาดที่เกิดขึ้น
</p>
<p>
    <strong>ไม่ควรเปิดใช้งานสภาพแวดล้อม Development สำหรับแอปพลิเคชันที่ใช้งานจริง</strong>
    เนื่องจากอาจส่งผลให้มีการแสดงข้อมูลที่ละเอียดอ่อนจากข้อยกเว้นไปยังผู้ใช้ปลายทาง
    สำหรับการดีบักในเครื่อง ให้เปิดใช้งานสภาพแวดล้อม <strong>Development</strong> โดยตั้งค่าตัวแปรสภาพแวดล้อม <strong>ASPNETCORE_ENVIRONMENT</strong> เป็น <strong>Development</strong>
    แล้วรีสตาร์ทแอป
</p>
