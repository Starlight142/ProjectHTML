@page
@model AromaSoulWeb.Pages.MyOrdersModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders | SoftScent</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
    <style>
        /* Specific styles for MyOrders */
        body {
            padding-top: 100px;
            background-color: var(--bg-color);
        }

        .orders-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem 5%;
        }

        .page-header {
            text-align: center;
            margin-bottom: 3rem;
            animation: fadeIn 0.8s ease-out;
        }
        
        .page-header h1 {
            color: var(--primary);
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }

        .order-card {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: transform 0.3s;
            border: 1px solid rgba(0,0,0,0.05);
            animation: fadeIn 0.5s ease-out forwards;
            opacity: 0;
        }

        .order-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(26, 77, 46, 0.1);
        }

        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 1rem;
            margin-bottom: 1rem;
        }

        .order-id {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            color: var(--primary);
            font-size: 1.2rem;
        }

        .order-date {
            color: var(--text-light);
            font-size: 0.9rem;
        }

        .order-items-list {
            list-style: none;
        }

        .order-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.8rem;
            font-size: 1rem;
        }

        .item-name {
            font-weight: 500;
            color: var(--text-dark);
        }

        .item-details {
            font-size: 0.85rem;
            color: var(--text-light);
            margin-top: 0.2rem;
        }

        .order-footer {
            margin-top: 1.5rem;
            padding-top: 1rem;
            border-top: 1px solid #f0f0f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .order-total {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--primary);
            font-weight: 700;
        }

        .status-badge {
            background: #E8F5E9;
            color: #2E7D32;
            padding: 0.4rem 1rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .empty-history {
            text-align: center;
            padding: 5rem 0;
            color: var(--text-light);
        }
        
        .empty-history p {
            font-size: 1.2rem;
            margin-bottom: 2rem;
        }
    </style>
</head>

<body>
    <nav class="glass-nav">
        <div class="logo"><a href="/#hero" style="text-decoration:none; color:inherit;">SoftScent</a></div>
        <ul class="nav-links">
            <li><a href="/#hero">Home</a></li>
            <li><a href="/#customizer">Create Blend</a></li>
            <li><a href="#" class="active">My Orders</a></li>
        </ul>
    </nav>

    <div class="orders-container">
        <div class="page-header">
            <h1>Your Order History</h1>
            <p>Track your past journeys into scent.</p>
        </div>

        <div id="ordersList">
            <!-- Orders injected via JS -->
            <div class="loading-spinner" style="text-align:center;">Loading...</div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const ordersList = document.getElementById('ordersList');
            const orders = JSON.parse(localStorage.getItem('orderHistory')) || [];

            if (orders.length === 0) {
                ordersList.innerHTML = `
                    <div class="empty-history">
                        <p>You haven't placed any orders yet.</p>
                        <a href="/#customizer" class="cta-btn-main">Start Blending</a>
                    </div>
                `;
                return;
            }

            ordersList.innerHTML = '';
            orders.forEach((order, index) => {
                const date = new Date(order.date).toLocaleDateString('en-US', {
                    year: 'numeric', month: 'long', day: 'numeric'
                });
                
                let itemsHtml = '';
                order.items.forEach(item => {
                    const herbNames = item.herbs ? item.herbs.map(h => h.name).join(', ') : 'Custom Blend';
                    itemsHtml += `
                        <div class="order-item">
                            <div>
                                <div class="item-name">${item.name}</div>
                                <div class="item-details">${herbNames}</div>
                            </div>
                            <div class="item-price">$${item.price.toFixed(2)}</div>
                        </div>
                    `;
                });

                const div = document.createElement('div');
                div.className = 'order-card';
                div.style.animationDelay = `${index * 0.1}s`;
                div.innerHTML = `
                    <div class="order-header">
                        <span class="order-id">Order #${order.id}</span>
                        <span class="order-date">${date}</span>
                    </div>
                    <div class="order-items-list">
                        ${itemsHtml}
                    </div>
                    <div class="order-footer">
                        <div class="status-badge">Processing</div>
                        <div class="order-total">$${order.total.toFixed(2)}</div>
                    </div>
                `;
                ordersList.appendChild(div);
            });
        });
    </script>
</body>
</html>
