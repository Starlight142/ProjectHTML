@page
@model AromaSoulWeb.Pages.CheckoutModel
@{
    Layout = null; // Standalone page to match Index style
}
<!DOCTYPE html>
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ชำระเงิน | SoftScent</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/checkout.css">
</head>

<body>
    <!-- Navbar (Simplified for Checkout) -->
    <nav class="glass-nav">
        <div class="logo"><a href="/#hero" style="text-decoration:none; color:inherit;">SoftScent</a></div>
        <div class="checkout-steps">
            <span class="step active">1. การจัดส่ง</span>
            <span class="step-line"></span>
            <span class="step">2. ชำระเงิน</span>
        </div>
        <div class="nav-right" style="display:flex; gap:1.5rem; align-items:center;">
            <a href="/MyOrders" class="back-link">รายการสั่งซื้อของฉัน</a>
            <a href="/#customizer" class="back-link">กลับไปที่การปรุงกลิ่น</a>
        </div>
    </nav>

    <div class="checkout-container">
        <div class="checkout-grid">
            <!-- Left Column: Forms -->
            <div class="form-section fade-in-up">
                
                <!-- Shipping Details -->
                <div class="checkout-card glass-panel-light" id="shippingSection">
                    <div class="card-header">
                        <h3>รายละเอียดการจัดส่ง</h3>
                    </div>
                    <form id="shippingForm">
                        <div class="form-row">
                            <div class="form-group half">
                                <label for="firstName">ชื่อจริง</label>
                                <input type="text" id="firstName" required placeholder="สมชาย">
                            </div>
                            <div class="form-group half">
                                <label for="lastName">นามสกุล</label>
                                <input type="text" id="lastName" required placeholder="ใจดี">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="email">อีเมล</label>
                            <input type="email" id="email" required placeholder="somchai@example.com">
                        </div>
                        <div class="form-group">
                            <label for="address">ที่อยู่</label>
                            <input type="text" id="address" required placeholder="123 ถนนสุขุมวิท">
                        </div>
                        <div class="form-row">
                            <div class="form-group half">
                                <label for="city">อำเภอ/เขต</label>
                                <input type="text" id="city" required placeholder="วัฒนา">
                            </div>
                            <div class="form-group quarter">
                                <label for="state">จังหวัด</label>
                                <input type="text" id="state" required placeholder="กทม.">
                            </div>
                            <div class="form-group quarter">
                                <label for="zip">รหัสไปรษณีย์</label>
                                <input type="text" id="zip" required placeholder="10110">
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Payment Details -->
                <div class="checkout-card glass-panel-light mt-2" id="paymentSection">
                    <div class="card-header">
                        <h3>วิธีการชำระเงิน</h3>
                    </div>
                    <form id="paymentForm">
                        <div class="payment-selector">
                            <div class="payment-option selected" data-method="card">
                                <input type="radio" name="paymentInfo" value="card" checked>
                                <span>บัตรเครดิต</span>
                            </div>
                            <div class="payment-option" data-method="qr">
                                <input type="radio" name="paymentInfo" value="qr">
                                <span>สแกนจ่าย (PromptPay)</span>
                            </div>
                            <div class="payment-option" data-method="paypal">
                                <input type="radio" name="paymentInfo" value="paypal">
                                <span>PayPal</span>
                            </div>
                        </div>

                        <!-- Credit Card Fields -->
                        <div id="card-fields" class="payment-fields">
                            <div class="credit-card-fields">
                                <div class="form-group">
                                    <label for="cardNum">หมายเลขบัตร</label>
                                    <div class="input-with-icon">
                                        <input type="text" id="cardNum" placeholder="0000 0000 0000 0000" maxlength="19">
                                        <span class="icon">💳</span>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group half">
                                        <label for="expiry">วันหมดอายุ</label>
                                        <input type="text" id="expiry" placeholder="MM/YY" maxlength="5">
                                    </div>
                                    <div class="form-group half">
                                        <label for="cvc">เลขหลังบัตร (CVC)</label>
                                        <input type="text" id="cvc" placeholder="123" maxlength="3">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="cardName">ชื่อผู้ถือบัตร</label>
                                    <input type="text" id="cardName" placeholder="ชื่อบนบัตร">
                                </div>
                            </div>
                        </div>

                        <!-- QR / PromptPay Section -->
                        <div id="qr-fields" class="payment-fields" style="display: none;">
                            <div class="qr-payment-container">
                                <div class="qr-header">
                                    <img src="https://upload.wikimedia.org/wikipedia/commons/c/c5/PromptPay-logo.png" alt="PromptPay" class="promptpay-logo" style="height: 40px; margin-bottom: 1rem;">
                                    <p>สแกน QR Code เพื่อชำระเงิน</p>
                                </div>
                                <div class="qr-code-box">
                                    <!-- Placeholder for generated QR -->
                                    <img src="/images/mock_qr.png" alt="Payment QR Code" id="paymentQrCode" style="max-width: 200px; border: 1px solid #ddd; border-radius: 8px;">
                                </div>
                                <div class="qr-instructions">
                                    <p class="small-text">รองรับทุกธนาคารในประเทศไทย</p>
                                    <div class="timer-warning">กรุณาชำระเงินภายใน <span id="paymentTimer">15:00</span> นาที</div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- PayPal Section (Simple Message) -->
                        <div id="paypal-fields" class="payment-fields" style="display: none;">
                             <div class="paypal-info" style="text-align: center; padding: 2rem;">
                                <p>คุณจะถูกนำไปยังเว็บไซต์ PayPal เพื่อดำเนินการชำระเงินอย่างปลอดภัย</p>
                             </div>
                        </div>

                    </form>
                </div>

            </div>

            <!-- Right Column: Order Summary -->
            <div class="summary-section fade-in-up" style="animation-delay: 0.2s;">
                <div class="checkout-card glass-panel-dark">
                    <h3>สรุปคำสั่งซื้อ</h3>
                    
                    <div class="order-items" id="orderItems">
                        <!-- Items injected via JS -->
                        <div class="loading-spinner">กำลังโหลดตะกร้า...</div>
                    </div>

                    <div class="price-breakdown">
                        <div class="price-row">
                            <span>ยอดรวมย่อย</span>
                            <span id="subtotalDisplay">฿0.00</span>
                        </div>
                        <div class="price-row">
                            <span>ค่าจัดส่ง</span>
                            <span id="shippingDisplay">ฟรี</span>
                        </div>
                        <div class="price-row total">
                            <span>ยอดรวมสุทธิ</span>
                            <span id="totalDisplay">฿0.00</span>
                        </div>
                    </div>

                    <button id="placeOrderBtn" class="cta-btn-main full-width">
                        ยืนยันการชำระเงิน
                    </button>
                    
                    <p class="secure-notice">🔒 ชำระเงินปลอดภัยด้วยการเข้ารหัส SSL 256-bit</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="success-overlay" id="successOverlay">
        <div class="success-modal">
            <div class="success-icon">✨</div>
            <h2>ยืนยันคำสั่งซื้อเรียบร้อย!</h2>
            <p>ขอบคุณสำหรับการสั่งซื้อ ภูมิปัญญาแห่งธรรมชาติกำลังเดินทางไปหาคุณ</p>
            <p class="order-id">หมายเลขคำสั่งซื้อ #<span id="orderId"></span></p>
            <a href="/" class="cta-btn-main">กลับหน้าหลัก</a>
        </div>
    </div>

    <script src="~/js/checkout.js"></script>
</body>
</html>
