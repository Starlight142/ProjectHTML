@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoftScent | ยาดมสมุนไพรปรุงเอง</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
</head>

<body>
    <nav class="glass-nav">
        <div class="logo">SoftScent</div>
        <ul class="nav-links">
            <li><a href="#hero">หน้าหลัก</a></li>
            <li><a href="#about">ความหอม</a></li>
            <li><a href="/MyOrders" class="nav-item">รายการสั่งซื้อของฉัน</a></li>
            <li><a href="#customizer" class="cta-btn-small">ปรุงกลิ่น</a></li>
        </ul>
    </nav>

    <section id="hero" class="hero-section">
        <div class="hero-content">
            <h1>สูดรับ <br> <span>ภูมิปัญญาแห่งธรรมชาติ</span></h1>
            <p>สร้างสรรค์ยาดมสมุนไพรในแบบของคุณ เพื่อความผ่อนคลาย มีสมาธิ และความสงบ</p>
            <a href="#customizer" class="cta-btn-main">เริ่มปรุงกลิ่น</a>
        </div>
        <div class="hero-visual">
            <div class="floating-circle circle-1"></div>
            <div class="floating-circle circle-2"></div>
        </div>
    </section>

    <section id="about" class="about-section">
        <div class="container">
            <h2>ศิลปะแห่งการสูดดม</h2>
            <p>ศาสตร์โบราณผสานการปรับแต่งที่ทันสมัย เลือกสมุนไพรออร์แกนิกเกรดพรีเมียม ไม่จำกัดเพียงสมุนไพรไทยดั้งเดิม แต่รวมถึงลาเวนเดอร์ เปปเปอร์มินต์ ยูคาลิปตัส และอื่นๆ อีกมากมาย</p>
        </div>
    </section>

    <section id="customizer" class="customizer-section">
        <div class="container">
            <div class="customizer-header">
                <h2>ออกแบบกลิ่นของคุณ</h2>
                <p>เลือกสมุนไพรพื้นฐานและกลิ่นปรุงแต่งที่ต้องการ</p>
            </div>

            <div class="customizer-interface glass-panel">
                <div class="symptom-filter">
                    <span>ฉันอยากรู้สึก:</span>
                    <button class="filter-btn active" data-filter="all">ทั้งหมด</button>
                    <button class="filter-btn" data-filter="relaxed">ผ่อนคลาย</button>
                    <button class="filter-btn" data-filter="energized">สดชื่น</button>
                    <button class="filter-btn" data-filter="relief">โล่งจมูก</button>
                </div>

                <div class="selection-area">
                    <div class="herb-grid" id="herbGrid">
                        <!-- Herbs will be injected here via JS -->
                    </div>
                </div>

                <div class="blend-visuals">
                    <div class="inhaler-container">
                        <div class="inhaler-cap"></div>
                        <div class="inhaler-body" id="inhalerBody">
                            <!-- Visual layers injected here -->
                            <div class="inhaler-empty-text">ว่าง</div>
                        </div>
                        <div class="inhaler-base"></div>
                    </div>
                </div>

                <div class="blend-summary">
                    <h3>ส่วนผสมของคุณ</h3>
                    <ul id="blendList">
                        <li class="empty-state">เลือกสมุนไพรเพื่อเริ่มต้น...</li>
                    </ul>
                    <div class="blend-stats">
                        <div class="stat-bar">
                            <div class="fill" style="width: 0%"></div>
                        </div>
                    </div>
                    <div class="blend-name-input">
                        <input type="text" id="blendName" placeholder="ตั้งชื่อผลงานของคุณ..." maxlength="25">
                    </div>
                    <button id="addToCart" class="cta-btn-main" disabled>ใส่ตะกร้า - ฿390</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Cart Overlay Elements -->
    <button id="cartToggle" class="cart-floating-btn">
        <span class="cart-icon">🛍️</span>
        <span class="cart-count" id="cartCount">0</span>
    </button>

    <div class="cart-backdrop" id="cartBackdrop"></div>

    <div class="cart-overlay" id="cartOverlay">
        <div class="cart-header">
            <h3>ตะกร้าของคุณ</h3>
            <button class="close-cart" id="closeCart">×</button>
        </div>
        <div class="cart-items" id="cartItems">
            <!-- Cart items injected here -->
            <div class="empty-cart-msg">ตะกร้าของคุณว่างเปล่า</div>
        </div>
        <div class="cart-footer">
            <div class="cart-total">
                <span>รวม:</span>
                <span id="cartTotal">฿0.00</span>
            </div>
            <button class="cta-btn-main checkout-btn">ชำระเงิน</button>
        </div>
    </div>

    <footer>
        <p>&copy; 2025 SoftScent. หายใจสะดวก สุขภาพดี</p>
    </footer>

    <script src="~/js/main.js"></script>
</body>

</html>
