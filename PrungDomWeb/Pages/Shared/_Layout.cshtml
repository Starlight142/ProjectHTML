<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PrungDomWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PrungDomWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="container" style="padding-top: var(--spacing-sm); padding-bottom: var(--spacing-sm); display: flex; justify-content: space-between; align-items: center;">
        <a class="navbar-brand" asp-area="" asp-page="/Index" style="font-weight: 600; font-size: 1.5rem; color: var(--color-primary); letter-spacing: 2px;">PRUNG DOM</a>
        <nav>
            <a class="nav-link" asp-area="" asp-page="/Index" style="color: var(--color-text); margin-left: var(--spacing-md);">Home</a>
        </nav>
    </header>
    
    <main role="main">
        @RenderBody()
    </main>

    <footer class="container" style="margin-top: var(--spacing-lg); padding: var(--spacing-md) 0; border-top: 1px solid var(--color-border); text-align: center; color: var(--color-text-muted);">
        &copy; 2025 - PRUNG DOM - Breath Your Style
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
